                        <div class="shadow-sm border m-1 p-2 bg-white overflow-auto">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <input type="date" id="selectedStartDate" class="form-control"
                                           t-model="state.selectedStartDate" t-on-change="onChangeStartDate"
                                           t-att-disabled="state.isLoading"/>
                                </div>
                                <div>
                                    <input type="date" id="selectedEndDate" class="form-control"
                                           t-model="state.selectedEndDate" t-on-change="onChangeEndDate"
                                           t-att-disabled="state.isLoading"/>
                                </div>
<!--                                <div>-->
