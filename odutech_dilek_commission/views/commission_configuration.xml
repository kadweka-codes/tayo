<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--commission screen action-->
    <record id="dilek_commission_configuration_action" model="ir.actions.act_window">
        <field name="name">Commission Configuration Main Action</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">employee.commission</field>
        <field name="view_mode">list,form</field>
    </record>
    
    <!-- commission_configuration Search view -->
    <record id="commission_configuration_search_view" model="ir.ui.view">
        <field name="name">commission Configuration Search</field>
        <field name="model">employee.commission</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
            </search>
        </field>
    </record>

    <!-- commission_configuration screen Form & Tree view -->
    <record id="commission_configuration_screen_view_form" model="ir.ui.view">
        <field name="name">employee.commission.view.form</field>
        <field name="model">employee.commission</field>
        <field name="arch" type="xml">
            <form class="commission_configuration_form_view">
                <sheet>
                    <div class="row mt16 o_settings_container" name="auto_approval">
                        <group>
                            <field name="name" />
                            <field name="commission" />
                        </group>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="commission_configuration_view_tree" model="ir.ui.view">
        <field name="name">employee.commission.view.tree</field>
        <field name="model">employee.commission</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="commission" />
            </list>
        </field>
    </record>

     <record id="dilek_performance_configuration_action" model="ir.actions.act_window">
        <field name="name">Performance Categorization</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.department.pool</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="pool_performance_configuration_view_tree" model="ir.ui.view">
        <field name="name">hr.department.pool.view.tree</field>
        <field name="model">hr.department.pool</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="type" />
                <field name="percentage" />
            </list>
        </field>
    </record>
 <record id="performance_configuration_screen_view_form" model="ir.ui.view">
        <field name="name">hr.department.pool.view.form</field>
        <field name="model">hr.department.pool</field>
        <field name="arch" type="xml">
            <form class="commission_configuration_form_view">
                <sheet>
                    <div class="row mt16 o_settings_container" name="auto_approval">
                        <group>
                            <field name="name" />
                            <field name="type" />
                            <field name="percentage" />
                        </group>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>