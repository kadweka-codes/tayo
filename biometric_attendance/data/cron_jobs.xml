<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_get_attendance_transactions" model="ir.cron">
        <field name="name">Pull Attendance Transactions From ZKTeko</field>
        <field name="model_id" ref="biometric_attendance.model_attendance_attendance"/>
        <field name="state">code</field>
        <field name="code">model.fetch_data()</field>
        <field name='interval_number'>1</field>
        <field name='interval_type'>hours</field>
    </record>

     <record id="cron_update_employee_bio_data" model="ir.cron">
        <field name="name">Pull Employee Data From ZKTeko</field>
        <field name="model_id" ref="biometric_attendance.model_attendance_attendance"/>
        <field name="state">code</field>
        <field name="code">model.fetch_employee_data()</field>
        <field name='interval_number'>1</field>
        <field name='interval_type'>hours</field>
    </record>

    <record id="cron_update_attendance_bio_data" model="ir.cron">
        <field name="name">Update Attendance From ZKTeko</field>
        <field name="model_id" ref="biometric_attendance.model_attendance_attendance"/>
        <field name="state">code</field>
        <field name="code">model.process_attendance_logs()</field>
        <field name='interval_number'>1</field>
        <field name='interval_type'>hours</field>
    </record>
</odoo>
