<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kcb_buni_link_wizard" model="ir.ui.view">
        <field name="name">kcb.buni.link.wizard.form</field>
        <field name="model">kcb.buni.link.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Test Payment Link">
                <group>
                    <field name="config_id"/>
                    <field name="provider" invisible="1"/>
                    <field name="payment_channel" invisible="provider == 'manual'" required="provider != 'manual'"/>
                    <field name="phone_number" placeholder="2547XXXXXXXX" invisible="provider == 'manual'" required="provider != 'manual'"/>
                    <field name="amount"/>
                    <field name="transaction_description"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generate Test Payment Link" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_kcb_buni_link_wizard" model="ir.actions.act_window">
        <field name="name">Generate Test Payment Link</field>
        <field name="res_model">kcb.buni.link.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
