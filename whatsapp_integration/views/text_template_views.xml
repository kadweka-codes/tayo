<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="whatsapp_text_template_view_tree" model="ir.ui.view">
        <field name="name">whatsapp.text.template.tree</field>
        <field name="model">whatsapp.text.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="send_to"/>
            </list>
        </field>
    </record>

    <record id="whatsapp_text_template_view_form" model="ir.ui.view">
        <field name="name">whatsapp.text.template.form</field>
        <field name="model">whatsapp.text.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="send_to"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Placeholders: {{NameOfCook}}, {{NameOfWaiterOrCashier}}, {{NameOfWaiterWhoPlacedOrder}}, {{OrderNumber}}, {{TableNumber}}, {{Items}}, {{SpecialInstructions}}
                    </div>
                    <field name="body" placeholder="Dear {{NameOfCook}},&#10;Order Number {{OrderNumber}} has been assigned to you."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="whatsapp_text_template_action" model="ir.actions.act_window">
        <field name="name">WhatsApp Text Messages</field>
        <field name="res_model">whatsapp.text.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
