                                            <td t-att-class="row.FARQIGA.includes('(') ? 'text-danger' : ''">
                                                <span t-esc="row.FARQIGA"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 table-responsive">
