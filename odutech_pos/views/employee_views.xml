<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_employee_restaurant_role_form" model="ir.ui.view">
        <field name="name">hr.employee.restaurant.role</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='work_information']//field[@name='parent_id']" position="after">
                <field name="employee_restaurant_role"/>
            </xpath>
        </field>
    </record>

    <record id="hr_employee_public_restaurant_role_form" model="ir.ui.view">
        <field name="name">hr.employee.public.restaurant.role</field>
        <field name="model">hr.employee.public</field>
        <field name="inherit_id" ref="hr.hr_employee_public_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='work_information']//field[@name='parent_id']" position="after">
                <field name="employee_restaurant_role"/>
            </xpath>
        </field>
    </record>
</odoo>
