<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_employee_restaurant_role_form" model="ir.ui.view">
        <field name="name">hr.employee.restaurant.role</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='work_email']" position="after">
                <field name="employee_restaurant_role"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Mobile Money">
                    <group>
                        <field name="premier_wallet_number"/>
                        <field name="evc_plus_number"/>
                        <field name="e_ahab_number"/>
                        <field name="my_cash_number"/>
                        <field name="t_plus_number"/>
                        <field name="e_besa"/>
                        <field name="my_bank"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
