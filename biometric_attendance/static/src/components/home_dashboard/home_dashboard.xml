<!--                                    </select>-->
<!--                                </div>-->
                            </div>
                        </div>
                    </div>
                </div>

                <div t-if="state.isLoading" class="text-center p-5">
                    <div class="spinner-border text-primary" role="status"/>
                    <span class="ms-2">Loading data...</span>
                </div>

                <div t-else="" class="container-fluid">
                    <div class="row mb-4">
                        <div class="col-md-6 table-responsive">
                            <h3 class="mt-2"><span>STAFF DISCIPLINARY WARNINGS</span></h3>
                            <table class="table table-bordered text-center table-sm">
                                <thead>
                                    <tr class="text-white" style="background-color:#00205F;">
                                        <th>CABBIRKA</th>
                                        <th>ODOROSKA (Budget)</th>
                                        <th>DHABTA (Actual)</th>
                                        <th>FARQIGA (Difference)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.employeeWarnings" t-as="row" t-key="row.CABBIRKA">
                                        <tr>
                                            <td class="text-start" style="font-weight: 500;">
                                                <span t-esc="row.CABBIRKA"/>
                                            </td>
                                            <td><span t-esc="row.ODOROSKA"/></td>
                                            <td><span t-esc="row.DHABTA"/></td>
                                            <td t-att-class="row.FARQIGA.includes('(') ? 'text-danger' : ''">
                                                <span t-esc="row.FARQIGA"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <div class="col-md-6 table-responsive">
                            <h3 class="mt-2"><span>STAFF DATA</span></h3>
